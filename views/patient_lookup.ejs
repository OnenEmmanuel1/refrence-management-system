<%- include('partials/header') %>
<%- include('partials/sidebar', { activeTab: 'lookup' }) %>

<div class="href-main-content">
  <%- include('partials/navbar') %>

  <main class="href-container">
    <div class="mb-4">
      <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; margin: 0;">Patient Lookup</h1>
      <p style="color: var(--href-color-text-muted); margin: 0; font-size: 0.9rem;">Search for registered patient records to check details or initiate clinical department referrals.</p>
    </div>

    <% if (error) { %>
      <div class="href-alert href-alert-danger">
        <%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="href-alert href-alert-success">
        <%= success %>
      </div>
    <% } %>

    <div class="href-card">
      <h2 class="href-card-title">Search Patient Directory</h2>
      <div class="d-flex gap-2 mb-4">
        <input type="text" id="hrefPatientSearch" class="href-input" placeholder="Search by patient name, phone number, email, or database ID..." style="flex-grow: 1;">
        <button id="hrefSearchBtn" class="href-btn href-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="margin-right: var(--href-spacing-xs);">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Search
        </button>
      </div>

      <!-- Results Table -->
      <div class="table-responsive">
        <table id="hrefSearchResults" class="href-table" style="<%= (patients && patients.length > 0) ? '' : 'display: none;' %>">
          <thead>
            <tr>
              <th style="width: 100px;">Patient ID</th>
              <th>Full Name</th>
              <th>DOB</th>
              <th>Gender</th>
              <th style="text-align: right; width: 160px;">Actions</th>
            </tr>
          </thead>
          <tbody id="hrefSearchResultsBody">
            <% if (patients && patients.length > 0) { %>
              <% patients.forEach(p => { %>
                <tr class="patient-row" data-id="<%= p.id %>" data-name="<%= p.name.toLowerCase() %>" data-contact="<%= p.contact_info ? p.contact_info.toLowerCase() : '' %>">
                  <td><%= p.id %></td>
                  <td><strong><%= p.name %></strong></td>
                  <td><%= new Date(p.dob).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                  <td><%= p.gender %></td>
                  <td style="text-align: right;">
                    <% if (currentUser && currentUser.role === 'doctor') { %>
                      <a href="/references/create?patientId=<%= p.id %>" class="href-btn href-btn-primary" style="padding: 6px 12px; font-size: 0.8rem;">Refer Patient</a>
                    <% } else { %>
                      <span class="text-muted" style="font-size: 0.85rem;">Registered (ID: <%= p.id %>)</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
