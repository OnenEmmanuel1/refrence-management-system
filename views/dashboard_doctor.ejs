<%- include('partials/header') %>
<%- include('partials/sidebar', { activeTab: 'dashboard' }) %>

<div class="href-main-content">
  <%- include('partials/navbar') %>

  <main class="href-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; margin: 0;">Doctor Dashboard</h1>
        <p style="color: var(--href-color-text-muted); margin: 0; font-size: 0.9rem;">Monitor clinical patient referrals and status tracking.</p>
      </div>
      <div>
        <a href="/references/create" class="href-btn href-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="margin-right: var(--href-spacing-xs);">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          New Referral
        </a>
      </div>
    </div>

    <% if (error) { %>
      <div class="href-alert href-alert-danger">
        <%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="href-alert href-alert-success">
        <%= success %>
      </div>
    <% } %>

    <div class="href-card">
      <h2 class="href-card-title">My Referrals</h2>
      
      <% if (references.length === 0) { %>
        <div style="text-align: center; padding: var(--href-spacing-xl) 0; color: var(--href-color-text-muted);">
          No referrals initiated yet. Click "New Referral" above to get started.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="href-table">
            <thead>
              <tr>
                <th>Referral ID</th>
                <th>Patient Name</th>
                <th>Destination Department</th>
                <th>Status</th>
                <th>Date Initiated</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% references.forEach(ref => { %>
                <tr>
                  <td><%= ref.id %></td>
                  <td><strong><%= ref.patient_name %></strong></td>
                  <td><%= ref.dest_dept_name %></td>
                  <td>
                    <span class="href-badge href-badge-<%= ref.current_status.toLowerCase().replace(' ', '-') %>">
                      <%= ref.current_status %>
                    </span>
                  </td>
                  <td><%= new Date(ref.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                  <td style="text-align: right;">
                    <a href="/references/<%= ref.id %>" class="href-btn href-btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">
                      Track Status
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
