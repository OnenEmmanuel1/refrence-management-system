<%- include('partials/header') %>
<%- include('partials/sidebar', { activeTab: 'dashboard' }) %>

<div class="href-main-content">
  <%- include('partials/navbar') %>

  <main class="href-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; margin: 0;">Administrator Overview</h1>
        <p style="color: var(--href-color-text-muted); margin: 0; font-size: 0.9rem;">Hospital-wide referral throughput status and performance tracking.</p>
      </div>
      <div>
        <a href="/reports" class="href-btn href-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="margin-right: var(--href-spacing-xs);">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          Workload & Turnaround Reports
        </a>
      </div>
    </div>

    <!-- Metrics Grid -->
    <div class="href-metrics-grid">
      <div class="href-metric-card">
        <div class="href-metric-title">Total referrals</div>
        <div class="href-metric-value"><%= stats.total_count %></div>
      </div>
      <div class="href-metric-card" style="border-left: 4px solid var(--href-text-pending);">
        <div class="href-metric-title">Pending review</div>
        <div class="href-metric-value"><%= stats.pending_count %></div>
      </div>
      <div class="href-metric-card" style="border-left: 4px solid var(--href-text-progress);">
        <div class="href-metric-title">In Progress</div>
        <div class="href-metric-value"><%= stats.in_progress_count %></div>
      </div>
      <div class="href-metric-card" style="border-left: 4px solid var(--href-text-resolved);">
        <div class="href-metric-title">Resolved</div>
        <div class="href-metric-value"><%= stats.resolved_count %></div>
      </div>
      <div class="href-metric-card" style="border-left: 4px solid var(--href-text-rejected);">
        <div class="href-metric-title">Rejected</div>
        <div class="href-metric-value"><%= stats.rejected_count %></div>
      </div>
    </div>

    <% if (error) { %>
      <div class="href-alert href-alert-danger">
        <%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="href-alert href-alert-success">
        <%= success %>
      </div>
    <% } %>

    <div class="href-card">
      <h2 class="href-card-title">Recent Referrals (All Departments)</h2>
      
      <% if (recentReferences.length === 0) { %>
        <div style="text-align: center; padding: var(--href-spacing-xl) 0; color: var(--href-color-text-muted);">
          No referrals created in the system yet.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="href-table">
            <thead>
              <tr>
                <th>Referral ID</th>
                <th>Patient Name</th>
                <th>Source</th>
                <th>Destination</th>
                <th>Status</th>
                <th>Initiated At</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% recentReferences.forEach(ref => { %>
                <tr>
                  <td><%= ref.id %></td>
                  <td><strong><%= ref.patient_name %></strong></td>
                  <td><%= ref.source_dept_name %></td>
                  <td><%= ref.dest_dept_name %></td>
                  <td>
                    <span class="href-badge href-badge-<%= ref.current_status.toLowerCase().replace(' ', '-') %>">
                      <%= ref.current_status %>
                    </span>
                  </td>
                  <td><%= new Date(ref.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                  <td style="text-align: right;">
                    <a href="/references/<%= ref.id %>" class="href-btn href-btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">
                      Audit Timeline
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
