<%- include('partials/header') %>
<%- include('partials/sidebar', { activeTab: 'dashboard' }) %>

<div class="href-main-content">
  <%- include('partials/navbar') %>

  <main class="href-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; margin: 0;">Receptionist Dashboard</h1>
        <p style="color: var(--href-color-text-muted); margin: 0; font-size: 0.9rem;">Register new patient profiles and verify patient information.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/patients/lookup" class="href-btn href-btn-secondary">
          Patient Search
        </a>
        <a href="/patients/register" class="href-btn href-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="margin-right: var(--href-spacing-xs);">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Register Patient
        </a>
      </div>
    </div>

    <% if (error) { %>
      <div class="href-alert href-alert-danger">
        <%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="href-alert href-alert-success">
        <%= success %>
      </div>
    <% } %>

    <div class="href-card">
      <h2 class="href-card-title">Recently Registered Patients</h2>
      
      <% if (recentPatients.length === 0) { %>
        <div style="text-align: center; padding: var(--href-spacing-xl) 0; color: var(--href-color-text-muted);">
          No patients registered yet. Click "Register Patient" above to add the first profile.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="href-table">
            <thead>
              <tr>
                <th>Patient ID</th>
                <th>Name</th>
                <th>DOB</th>
                <th>Gender</th>
                <th>Contact Information</th>
                <th>Date Registered</th>
              </tr>
            </thead>
            <tbody>
              <% recentPatients.forEach(p => { %>
                <tr>
                  <td><%= p.id %></td>
                  <td><strong><%= p.name %></strong></td>
                  <td><%= new Date(p.dob).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                  <td><%= p.gender %></td>
                  <td><%= p.contact_info %></td>
                  <td><%= new Date(p.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
