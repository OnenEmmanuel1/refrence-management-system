<%- include('partials/header') %>
<%- include('partials/sidebar', { activeTab: 'register' }) %>

<div class="href-main-content">
  <%- include('partials/navbar') %>

  <main class="href-container">
    <div class="mb-4">
      <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; margin: 0;">Register New Patient</h1>
      <p style="color: var(--href-color-text-muted); margin: 0; font-size: 0.9rem;">Record new patient biodata to enable clinical department referrals.</p>
    </div>

    <div class="row">
      <div class="col-lg-8 col-md-10">
        <div class="href-card">
          <form id="hrefRegisterPatientForm">
            <div class="href-form-group">
              <label for="name" class="href-label">Full Name</label>
              <input type="text" id="name" name="name" class="href-input" placeholder="e.g. John Doe" required>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="href-form-group">
                  <label for="dob" class="href-label">Date of Birth</label>
                  <input type="date" id="dob" name="dob" class="href-input" required>
                </div>
              </div>
              <div class="col-md-6">
                <div class="href-form-group">
                  <label for="gender" class="href-label">Gender</label>
                  <select id="gender" name="gender" class="href-select" required>
                    <option value="" disabled selected>Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="href-form-group">
              <label for="contact_info" class="href-label">Contact Information</label>
              <textarea id="contact_info" name="contact_info" class="href-textarea" rows="3" placeholder="Phone number, email address, emergency contact..." required></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
              <a href="/dashboard" class="href-btn href-btn-secondary">Cancel</a>
              <button type="submit" class="href-btn href-btn-primary">Register Patient</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  document.getElementById('hrefRegisterPatientForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const dob = document.getElementById('dob').value;
    const gender = document.getElementById('gender').value;
    const contact_info = document.getElementById('contact_info').value;

    const submitBtn = e.target.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.innerText = 'Registering...';

    try {
      const res = await fetch('/api/patients/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ name, dob, gender, contact_info })
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Failed to register patient.');
        submitBtn.disabled = false;
        submitBtn.innerText = 'Register Patient';
        return;
      }

      alert('Patient registered successfully! Patient ID is: ' + data.patientId);
      window.location.href = '/dashboard';
    } catch (err) {
      console.error(err);
      alert('An error occurred during patient registration.');
      submitBtn.disabled = false;
      submitBtn.innerText = 'Register Patient';
    }
  });
</script>

<%- include('partials/footer') %>
